# Server Runtime Configuration
NODE_ENV="development" # Set to "production" in production environments
PORT="3000"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Lemon Squeezy Payment Gateway Configuration (Server-side only)
# Required for real $49 Fix Package checkout, 20% Outcome Fee, and webhook verification.
LEMON_SQUEEZY_API_KEY=""
LEMON_SQUEEZY_STORE_ID=""
# LEMON_SQUEEZY_VARIANT_ID or LEMON_SQUEEZY_FIX_PACKAGE_VARIANT_ID (both accepted as aliases)
LEMON_SQUEEZY_VARIANT_ID=""
LEMON_SQUEEZY_FIX_PACKAGE_VARIANT_ID=""
LEMON_SQUEEZY_OUTCOME_FEE_VARIANT_ID=""
# Webhook Secret is MANDATORY for both Fix Package and Outcome Fee payments:
LEMON_SQUEEZY_WEBHOOK_SECRET=""
# Lemon Squeezy Sandbox / Test Mode Configuration:
LEMON_SQUEEZY_SANDBOX="false"
LEMON_SQUEEZY_SANDBOX_API_KEY=""

# Turso / libSQL Production Database Configuration (Server-side only)
# Note: The codebase (src/server/db/index.ts, src/server/storage.ts, scripts/migrate-db.ts, drizzle.config.ts)
# explicitly binds to TURSO_DATABASE_URL and TURSO_AUTH_TOKEN.
# Do NOT configure generic DATABASE_URL or DATABASE_AUTH_TOKEN as they are not read by the application.
# In development/test, defaults to local SQLite (file:data/aidiscost.db) or in-memory (:memory:).
# In production (NODE_ENV=production), TURSO_DATABASE_URL (and TURSO_AUTH_TOKEN for remote URLs) is required.
# Migrations do NOT execute automatically on server startup; apply them explicitly via: npm run db:migrate
TURSO_DATABASE_URL="libsql://your-db-org.turso.io"
TURSO_AUTH_TOKEN=""

# Dedicated Disposable Remote Turso Test Database (for npm run test:turso)
TURSO_TEST_DATABASE_URL=""
TURSO_TEST_AUTH_TOKEN=""
TURSO_ALLOW_TEST_MIGRATIONS="false"



